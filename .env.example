# Configurazione Firebase (Web App).
# Copia questo file in ".env" (stessa cartella) e compila i valori.
#
# Dove trovarli: Firebase Console > Impostazioni progetto (ingranaggio) >
#   Generali > Le tue app > App Web > "SDK setup and configuration" > Config.
#
# NOTA: queste chiavi NON sono segrete (sono pensate per stare nel client).
# La sicurezza dei dati e' garantita da Firebase Authentication
# + firestore.rules e l'abilitazione members/{uid}.active = true.
# Vedi docs/firebase.md. Non inserire mai credenziali Admin SDK o service account.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
